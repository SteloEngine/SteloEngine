#pragma once

#include <metal_stdlib>
using namespace metal;

struct WidgetGPU {
    float4 background;
    float4 borderColor;

    float4 margin;
    float4 border;

    float4 cornerRadius;

    float2 position;
    float2 size;

    float2 uvMin;
    float2 uvMax;

    uint textureBG;
    uint textureBorder;

    uint flags;

    uint parent;

    uint align;
};

struct VertexIn {
    float2 position [[attribute(0)]];
    uint widgetID [[attribute(1)]];
};

struct VertexOut {
    float4 position [[position]];
    float2 uv;
    uint widgetID;
};

vertex VertexOut vs_main(
    VertexIn in                 [[stage_in]],
    constant Widget* widgets    [[buffer(0)]]
) {
    VertexOut out;
    for (int i = 0; i < 10; i++) {
        Widget widget = widgets[in.widgetID];
    }
    Widget widget = widgets[in.widgetID];

    float2 pos = widget.position + in.position * widget.size;

    out.position = float4(pos, 0.0, 1.0);

    out.uv = in.position;

    out.widgetID = in.widgetID;

    return out;
}

fragment float4 fs_main(
    VertexOut in [[stage_in]],
    constant Widget* widgets [[buffer(0)]],
    texture2d<float> textures [[texture(0)]]
) {
    Widget widget = widgets[in.widgetID];

    constexpr sampler s(
        mag_filter::linear,
        min_filter::linear
    );

    float4 color = widget._background;

    if (widget.textureBG > 0) {
        color *= textures.sample(s, in.uv);
    }

    return color;
}